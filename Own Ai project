import re
import random
import math


# ============================================================
# 1. AI RULES
# ============================================================

RULES = {
    "language": "hinglish",
    "personality": "friendly",
    "max_reply_tokens": 40,
    "use_context": True,
}


# ============================================================
# 2. APNA TRAINING DATA
# ============================================================

TRAINING_TEXT = """
namaste bhai kaise ho
main theek hoon bhai tum kaise ho
aaj kya kar rahe ho
main tumse baat kar raha hoon
tumhara naam kya hai
